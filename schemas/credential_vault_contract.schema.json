{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agos.local/schemas/credential_vault_contract.schema.json",
  "title": "AGOS Credential Vault Contract",
  "type": "object",
  "required": [
    "contract_id",
    "round_id",
    "phase",
    "status",
    "forbiddenCredentialHandling",
    "allowedCredentialHandling",
    "credentialReferencePolicy",
    "credentialAuditTemplate",
    "secretBoundaryPolicy",
    "secretBoundaryEvidence"
  ],
  "properties": {
    "contract_id": {
      "const": "CREDENTIAL_VAULT_CONTRACT"
    },
    "round_id": {
      "const": "ROUND-REALDATA-002_CREDENTIAL_VAULT_AND_SECRET_BOUNDARY"
    },
    "phase": {
      "const": "AGOS_REAL_DATA_CONTROLLED_ACCESS"
    },
    "status": {
      "const": "credential_contract_defined_no_secrets"
    },
    "forbiddenCredentialHandling": {
      "type": "array",
      "contains": {
        "const": "no tokens in Git"
      },
      "minItems": 5
    },
    "allowedCredentialHandling": {
      "type": "array",
      "contains": {
        "const": "external vault reference"
      },
      "minItems": 5
    },
    "credentialReferencePolicy": {
      "type": "object",
      "required": [
        "store_reference_only",
        "secret_value_storage_allowed",
        "runtime_json_secret_storage_allowed",
        "git_secret_storage_allowed",
        "env_write_allowed_by_agos",
        "log_secret_allowed",
        "screenshot_secret_allowed"
      ],
      "properties": {
        "store_reference_only": {
          "const": true
        },
        "secret_value_storage_allowed": {
          "const": false
        },
        "runtime_json_secret_storage_allowed": {
          "const": false
        },
        "git_secret_storage_allowed": {
          "const": false
        },
        "env_write_allowed_by_agos": {
          "const": false
        },
        "log_secret_allowed": {
          "const": false
        },
        "screenshot_secret_allowed": {
          "const": false
        }
      }
    },
    "credentialAuditTemplate": {
      "type": "object",
      "required": [
        "credentialAuditFields",
        "credentialAuditRows",
        "real_credentials_included",
        "template_only"
      ]
    },
    "secretBoundaryPolicy": {
      "type": "object",
      "required": [
        "storagePolicy",
        "allowedHandlingPolicy",
        "executionBoundary"
      ]
    },
    "secretBoundaryEvidence": {
      "type": "object",
      "required": [
        "credential_vault_contract_defined",
        "real_secrets_requested_in_chat",
        "real_tokens_stored",
        "real_platform_api_called",
        "real_data_ingested",
        "agos_training_started",
        "write_api_allowed"
      ]
    }
  }
}
